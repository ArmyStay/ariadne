-- Migration 7: the evening reminder.
--
-- Four columns on the one-row settings table rather than a table of its own: this is
-- a preference, not a record. `reminderEnabled` is 0 by default, so an existing
-- install wakes up with the reminder off and is asked once, in the app, before
-- anything is armed on the device.
--
-- `reminderAsked` is what makes the offer a single popup: the first evening after a
-- trip exists is the only time the app asks, and declining is remembered.

ALTER TABLE settings ADD COLUMN reminderEnabled INTEGER NOT NULL DEFAULT 0;
ALTER TABLE settings ADD COLUMN reminderHour INTEGER NOT NULL DEFAULT 20;
ALTER TABLE settings ADD COLUMN reminderMinute INTEGER NOT NULL DEFAULT 0;
ALTER TABLE settings ADD COLUMN reminderAsked INTEGER NOT NULL DEFAULT 0;
