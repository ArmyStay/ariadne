-- Migration 1 -> 2: capture gained category and note.
--
-- Two schema changes happened before this project wrote migrations down, and the
-- history matters, because a database in the wild can be at either point:
--
--   baseline (81df38b)  trip has no place/budget; capture has no category/note
--   v2       (1ebe7d0)  capture gained category and note      <- this file
--   v3       (b9bcc4b)  trip gained place and budgetMinor     <- 2.sqm
--
-- Both are nullable on purpose: a capture is valid without either. Category is
-- what a person says it was; note is anything they want to remember about it.

ALTER TABLE capture ADD COLUMN category TEXT;

ALTER TABLE capture ADD COLUMN note TEXT;
