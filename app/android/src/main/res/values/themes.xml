<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/windowBackgroundColor</item>
    </style>

    <!-- The system splash until the app is up, then the app theme.
         installSplashScreen() runs first in MainActivity. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/windowBackgroundColor</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ariadne_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
